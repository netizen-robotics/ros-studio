<!-- Synthetic localhost fixture only; requires RMW_FASTRTPS_USE_QOS_FROM_XML=1. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>fixture_loopback</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
      <maxMessageSize>65000</maxMessageSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="fixture_loopback" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>fixture_loopback</transport_id></userTransports>
      <flow_controller_descriptor_list>
        <flow_controller_descriptor>
          <name>fixture_paced</name>
          <scheduler>FIFO</scheduler>
          <max_bytes_per_period>65536</max_bytes_per_period>
          <period_ms>4</period_ms>
        </flow_controller_descriptor>
      </flow_controller_descriptor_list>
    </rtps>
  </participant>
  <data_writer profile_name="fixture_data_writer" is_default_profile="true">
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
    <qos>
      <publishMode>
        <kind>ASYNCHRONOUS</kind>
        <flow_controller_name>fixture_paced</flow_controller_name>
      </publishMode>
    </qos>
  </data_writer>
  <data_reader profile_name="fixture_data_reader" is_default_profile="true">
    <historyMemoryPolicy>PREALLOCATED_WITH_REALLOC</historyMemoryPolicy>
  </data_reader>
</profiles>
