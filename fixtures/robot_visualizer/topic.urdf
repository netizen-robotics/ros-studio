<?xml version="1.0"?>
<robot name="topic_fixture_robot">
  <link name="base">
    <visual><origin xyz="0 0 0.1"/><geometry><box size="0.6 0.4 0.2"/></geometry><material><color rgba="0.9 0.15 0.1 1"/></material></visual>
  </link>
  <link name="arm">
    <visual><origin xyz="0 0 0.3"/><geometry><cylinder radius="0.08" length="0.6"/></geometry><material><color rgba="0.15 0.8 0.25 1"/></material></visual>
  </link>
  <joint name="shoulder" type="revolute"><parent link="base"/><child link="arm"/><origin xyz="0 0 0.2"/><axis xyz="0 1 0"/><limit lower="-1.5" upper="1.5" effort="1" velocity="1"/></joint>
</robot>
