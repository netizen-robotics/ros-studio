<robot name="collision_fixture">
  <link name="base">
    <visual>
      <origin xyz="0 0 0.5"/>
      <geometry><box size="1 1 1"/></geometry>
      <material><color rgba="0.1 0.7 0.65 1"/></material>
    </visual>
    <collision name="base_envelope">
      <origin xyz="0 0 0.6"/>
      <geometry><box size="1.2 1.2 1.2"/></geometry>
    </collision>
  </link>
  <link name="tip">
    <collision name="tip_mesh">
      <origin xyz="0 0 1"/>
      <geometry><mesh filename="materials/textured.obj"/></geometry>
    </collision>
  </link>
  <joint name="base_to_tip" type="fixed">
    <parent link="base"/><child link="tip"/><origin xyz="2 0 0"/>
  </joint>
</robot>
